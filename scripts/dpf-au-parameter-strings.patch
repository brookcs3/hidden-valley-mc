+    // an indexed parameter whose positions all have enumeration labels can publish them as value strings
+    bool parameterHasValueStrings(const uint32_t index) const
+    {
+        const uint32_t hints = fPlugin.getParameterHints(index);
+
+        if ((hints & kParameterIsInteger) == 0x0 || (hints & kParameterIsBoolean) != 0x0)
+            return false;
+
+        return fPlugin.getParameterEnumValues(index).count != 0;
+    }
+
+    // the enumeration label for a parameter value (integer parameters are rounded first), retained, or null if none matches
+    CFStringRef copyParameterValueLabel(const uint32_t index, float value) const
+    {
+        const ParameterEnumerationValues& enumValues(fPlugin.getParameterEnumValues(index));
+
+        if (fPlugin.getParameterHints(index) & kParameterIsInteger)
+            value = std::round(value);
+
+        for (uint32_t i = 0; i < enumValues.count; ++i)
+        {
+            if (d_isEqual(enumValues.values[i].value, value))
+                return CFStringCreateWithCString(nullptr, enumValues.values[i].label, kCFStringEncodingUTF8);
+        }
+
+        return nullptr;
+    }
